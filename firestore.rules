rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security role checking and multi-tenant college isolation
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOfficialOwner() {
      return isAuthenticated() && (getUserData().role == 'OFFICIAL_OWNER' || getUserData().role == 'ADMIN');
    }

    function isCollegeAdmin() {
      return isAuthenticated() && (getUserData().role == 'COLLEGE_ADMIN' || getUserData().role == 'ADMIN' || getUserData().role == 'HOD');
    }

    function isTeacher() {
      return isAuthenticated() && getUserData().role == 'TEACHER';
    }

    function isStudent() {
      return isAuthenticated() && getUserData().role == 'STUDENT';
    }

    function isSameCollege(collegeId) {
      return isAuthenticated() && (getUserData().collegeId == collegeId || collegeId == null || collegeId == '');
    }

    // Collection Level Rules

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOfficialOwner() || request.auth.uid == userId || isCollegeAdmin();
    }

    // Multi-tenant Colleges Collection
    match /colleges/{collegeId} {
      allow read: if isAuthenticated();
      allow write: if isOfficialOwner();
    }

    // Master Data Collections
    match /departments/{deptId} {
      allow read: if isAuthenticated();
      allow write: if isOfficialOwner() || isCollegeAdmin();
    }

    match /faculty/{facultyId} {
      allow read: if isAuthenticated();
      allow write: if isOfficialOwner() || isCollegeAdmin();
    }

    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow write: if isOfficialOwner() || isCollegeAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isOfficialOwner() || isCollegeAdmin();
    }

    match /semesters/{semesterId} {
      allow read: if isAuthenticated();
      allow write: if isOfficialOwner() || isCollegeAdmin();
    }

    match /sections/{sectionId} {
      allow read: if isAuthenticated();
      allow write: if isOfficialOwner() || isCollegeAdmin();
    }

    match /classrooms/{classroomId} {
      allow read: if isAuthenticated();
      allow write: if isOfficialOwner() || isCollegeAdmin();
    }

    match /laboratories/{labId} {
      allow read: if isAuthenticated();
      allow write: if isOfficialOwner() || isCollegeAdmin();
    }

    match /classAssignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isOfficialOwner() || isCollegeAdmin();
    }

    match /classSessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isOfficialOwner() || isCollegeAdmin() || isTeacher();
    }

    // Timetables generated by Genetic Engine
    match /timetables/{timetableId} {
      allow read: if isAuthenticated();
      allow write: if isOfficialOwner() || isCollegeAdmin();
    }

    // Attendance Records
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow write: if isOfficialOwner() || isCollegeAdmin() || isTeacher();
    }

    // Assignments & Resources
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isOfficialOwner() || isCollegeAdmin() || isTeacher();
    }

    match /resources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isOfficialOwner() || isCollegeAdmin() || isTeacher();
    }

    // Quizzes & Attempts
    match /quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow write: if isOfficialOwner() || isCollegeAdmin() || isTeacher();
    }

    match /quizAttempts/{attemptId} {
      allow read: if isAuthenticated();
      allow create: if isStudent() || isTeacher();
      allow update, delete: if isOfficialOwner() || isCollegeAdmin() || isTeacher();
    }

    match /quiz_attempts/{attemptId} {
      allow read: if isAuthenticated();
      allow create: if isStudent() || isTeacher();
      allow update, delete: if isOfficialOwner() || isCollegeAdmin() || isTeacher();
    }

    // Leave Requests & Substitutions
    match /leaveRequests/{leaveId} {
      allow read: if isAuthenticated();
      allow create: if isTeacher() || isStudent();
      allow update, delete: if isOfficialOwner() || isCollegeAdmin() || isTeacher();
    }

    match /substitutions/{subId} {
      allow read: if isAuthenticated();
      allow write: if isOfficialOwner() || isCollegeAdmin() || isTeacher();
    }

    // Discussion Forum
    match /discussionPosts/{postId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isOfficialOwner() || isCollegeAdmin() || isTeacher();
    }

    // Notifications & Reminders
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /reminders/{reminderId} {
      allow read, write: if isAuthenticated();
    }

    // Exams & IA Timetables
    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow write: if isOfficialOwner() || isCollegeAdmin();
    }

    match /iaTimetables/{iaId} {
      allow read: if isAuthenticated();
      allow write: if isOfficialOwner() || isCollegeAdmin();
    }

    // Analytics Reports & Platform Updates
    match /analyticsReports/{reportId} {
      allow read: if isAuthenticated();
      allow write: if isOfficialOwner() || isCollegeAdmin();
    }

    match /platformUpdates/{updateId} {
      allow read: if isAuthenticated();
      allow write: if isOfficialOwner();
    }
  }
}

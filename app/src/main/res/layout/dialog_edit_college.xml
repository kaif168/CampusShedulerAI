<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <EditText
            android:id="@+id/etEditCollegeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="College Name *"
            android:inputType="textCapWords"
            android:padding="12dp"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etEditCollegeCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="College Code *"
            android:inputType="textCapCharacters"
            android:padding="12dp"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etEditCollegeAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="College Address"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2"
            android:gravity="top"
            android:padding="12dp"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etEditCollegeEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Contact Email"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etEditCollegePhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Contact Phone"
            android:inputType="phone"
            android:padding="12dp"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
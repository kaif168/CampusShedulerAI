<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical"
    android:background="#F4F8FC">

    <!-- ========================================================= -->
    <!-- OWNER SETTINGS APP BAR                                    -->
    <!-- ========================================================= -->

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"

        android:background="#1565C0"
        android:elevation="5dp"

        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"

            android:layout_width="48dp"
            android:layout_height="48dp"

            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"

            android:background="?attr/selectableItemBackgroundBorderless"

            android:contentDescription="Back"

            android:src="@android:drawable/ic_menu_revert"

            app:tint="@android:color/white" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_centerVertical="true"
            android:layout_marginStart="6dp"
            android:layout_toEndOf="@id/btnBack"

            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Account Settings"

                android:textColor="@android:color/white"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSettingsSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="1dp"

                android:text="College Admin Account"

                android:textColor="#DCEEFF"
                android:textSize="11sp" />

        </LinearLayout>

    </RelativeLayout>


    <!-- ========================================================= -->
    <!-- CONTENT                                                    -->
    <!-- ========================================================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:fillViewport="true"

        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical">


            <!-- ================================================= -->
            <!-- ACCOUNT INFORMATION CARD                           -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardUseCompatPadding="true">

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="20dp">

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Account Information"

                        android:textColor="#0D47A1"
                        android:textSize="17sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/tvSettingsEmail"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="16dp"

                        android:text="Email Address: --"

                        android:textColor="#455A64"
                        android:textSize="14sp" />


                    <TextView
                        android:id="@+id/tvSettingsPhone"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="10dp"

                        android:text="Phone Number: --"

                        android:textColor="#455A64"
                        android:textSize="14sp" />


                    <TextView
                        android:id="@+id/tvSettingsRole"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="10dp"

                        android:text="Account Role: OFFICIAL_OWNER"

                        android:textColor="#455A64"
                        android:textSize="14sp" />


                    <!-- ========================================= -->
                    <!-- PASSWORD                                    -->
                    <!-- ========================================= -->

                    <Button
                        android:id="@+id/btnResetPassword"

                        android:layout_width="match_parent"
                        android:layout_height="50dp"

                        android:layout_marginTop="22dp"

                        android:background="#1565C0"

                        android:text="CHANGE / RESET PASSWORD"

                        android:textColor="@android:color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"

                        app:backgroundTint="@null" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================================= -->
            <!-- INSTITUTION & CAMPUS PROFILE CARD                  -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Institution &amp; Campus Profile"
                        android:textColor="#0D47A1"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSettingsCollegeName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Institution: HKBK College of Engineering"
                        android:textColor="#263238"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSettingsCollegeLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Campus Location: Nagawara, Bengaluru, Karnataka 560045"
                        android:textColor="#1976D2"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSettingsCollegeCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="College Code: hkbkce"
                        android:textColor="#455A64"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvSettingsCollegeTenant"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Tenant ID: COLLEGE_1789406176044"
                        android:textColor="#455A64"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvSettingsCollegeDepartment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Department: Computer Science &amp; Engineering"
                        android:textColor="#455A64"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvSettingsCollegeContact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Official Contact: hkbkadmin@gmail.com • 080-12345678"
                        android:textColor="#455A64"
                        android:textSize="13sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================================= -->
            <!-- PLATFORM ACCOUNT INFORMATION                       -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="14dp"

                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="18dp">

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Platform Access"

                        android:textColor="#1565C0"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSettingsPlatformAccess"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="7dp"

                        android:text="Authorized College Administrator with full academic governance, timetable management, and faculty control for this institution."

                        android:textColor="#607D8B"
                        android:textSize="13sp"

                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================================= -->
            <!-- SECURITY INFORMATION                               -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="14dp"

                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true">

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="18dp">

                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Security"

                        android:textColor="#1565C0"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="7dp"

                        android:text="Use the password reset option above to update account credentials. Firebase Authentication remains the source of authentication."

                        android:textColor="#607D8B"
                        android:textSize="13sp"

                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


        </LinearLayout>

    </ScrollView>

</LinearLayout>
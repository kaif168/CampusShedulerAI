<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="240dp"
    android:orientation="vertical"
    android:background="#1565C0"
    android:paddingStart="20dp"
    android:paddingTop="30dp"
    android:paddingEnd="20dp"
    android:paddingBottom="18dp">

    <ImageView
        android:id="@+id/ivNavOwnerAvatar"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="#E3F2FD"
        android:padding="10dp"
        android:src="@android:drawable/ic_menu_myplaces"
        app:tint="#1565C0"
        android:contentDescription="Official Owner" />

    <TextView
        android:id="@+id/tvNavOwnerName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Official Platform Owner"
        android:textColor="@android:color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/tvNavOwnerScope"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Global Platform Governance"
        android:textColor="#DCEEFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvNavOwnerSystem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="CampusSchedulerAI Master Account"
        android:textColor="#EAF4FF"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
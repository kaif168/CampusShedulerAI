<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F8FC">

    <!-- HEADER -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#1565C0"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btnBack"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Timetable Generator"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HKBK College of Engineering • AI Scheduling Engine"
                android:textColor="#BBDEFB"
                android:textSize="11sp" />

        </LinearLayout>

    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- GENERATOR SETUP CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1. Timetable Configuration"
                        android:textColor="#0D47A1"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Select the academic cohort to schedule conflict-free classes."
                        android:textColor="#607D8B"
                        android:textSize="12sp" />

                    <!-- DEPARTMENT -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Department"
                        android:textColor="#263238"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinnerDepartment"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:backgroundTint="#1565C0" />

                    <!-- ACADEMIC YEAR -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Academic Year"
                        android:textColor="#263238"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinnerAcademicYear"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:backgroundTint="#1565C0" />

                    <!-- SEMESTER & SECTION SIDE BY SIDE -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Semester"
                                android:textColor="#263238"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <Spinner
                                android:id="@+id/spinnerSemester"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="4dp"
                                android:backgroundTint="#1565C0" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Section"
                                android:textColor="#263238"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <Spinner
                                android:id="@+id/spinnerSection"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="4dp"
                                android:backgroundTint="#1565C0" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- WORKING DAYS -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Working Days"
                        android:textColor="#263238"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <CheckBox
                            android:id="@+id/checkMonday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mon"
                            android:checked="true" />

                        <CheckBox
                            android:id="@+id/checkTuesday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tue"
                            android:checked="true" />

                        <CheckBox
                            android:id="@+id/checkWednesday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wed"
                            android:checked="true" />

                        <CheckBox
                            android:id="@+id/checkThursday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thu"
                            android:checked="true" />

                        <CheckBox
                            android:id="@+id/checkFriday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fri"
                            android:checked="true" />

                        <CheckBox
                            android:id="@+id/checkSaturday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sat" />

                    </LinearLayout>

                    <!-- CLASS TEACHER & ACADEMIC DETAILS -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Class Teacher"
                        android:textColor="#263238"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinnerClassTeacher"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:backgroundTint="#1565C0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Effective Date (W.E.F.)"
                        android:textColor="#263238"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWefDate"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="4dp"
                        android:background="#F0F4F8"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="W.E.F.: 2026-08-01 (Click to change)"
                        android:textColor="#1565C0"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Coordinator"
                                android:textColor="#263238"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etCoordinatorName"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="4dp"
                                android:background="#F0F4F8"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="Dr. Sivarajan"
                                android:textColor="#263238"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="HOD"
                                android:textColor="#263238"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etHodName"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="4dp"
                                android:background="#F0F4F8"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="Dr. Vilasini M"
                                android:textColor="#263238"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Principal"
                                android:textColor="#263238"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etPrincipalName"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginTop="4dp"
                                android:background="#F0F4F8"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="Dr. Pushpa Mohan"
                                android:textColor="#263238"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 2. SUBJECT SELECTION CARD (DYNAMIC PER SEMESTER) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSubjectSelection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2. Select Subjects to Schedule"
                                android:textColor="#0D47A1"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvSubjectSelectionSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Choose eligible subjects for this generation run:"
                                android:textColor="#607D8B"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnToggleSelectAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:background="#E3F2FD"
                            android:text="Select All"
                            android:textColor="#1565C0"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- EMPTY OR STATUS STATE -->
                    <TextView
                        android:id="@+id/tvSubjectSelectionStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Select an academic group above to load eligible subjects."
                        android:textColor="#78909C"
                        android:textSize="13sp"
                        android:padding="8dp" />

                    <!-- DYNAMIC SUBJECT LIST CONTAINER -->
                    <LinearLayout
                        android:id="@+id/llSubjectListContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <!-- MAP MORE SUBJECTS ACTION BUTTON -->
                    <Button
                        android:id="@+id/btnOpenClassMapping"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="#ECEFF1"
                        android:text="+ MAP SUBJECTS &amp; FACULTY IN ADMIN"
                        android:textColor="#1565C0"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- GENERATE BUTTON -->
                    <Button
                        android:id="@+id/btnRunGAEngine"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="#1565C0"
                        android:text="GENERATE AI TIMETABLE"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 3. RESULT & PREVIEW CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="visible"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- OFFICIAL HKBK TIMETABLE HEADER -->
                    <LinearLayout
                        android:id="@+id/llOfficialTimetableHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:padding="14dp"
                        android:background="#F8FAFC">

                        <!-- Original HKBK College Logo — centered -->
                        <ImageView
                            android:id="@+id/ivHkbkTimetableLogo"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:layout_gravity="center_horizontal"
                            android:adjustViewBounds="true"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_hkbk_logo"
                            android:contentDescription="HKBK College of Engineering Logo" />

                        <!-- HKBK COLLEGE OF ENGINEERING -->
                        <TextView
                            android:id="@+id/tvHkbkCollegeTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="HKBK COLLEGE OF ENGINEERING"
                            android:textColor="#0D47A1"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/tvHkbkCollegeSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Approved by AICTE, New Delhi • Affiliated to VTU, Belagavi • Bengaluru - 560045"
                            android:textColor="#546E7A"
                            android:textSize="11sp"
                            android:gravity="center" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            android:background="#CFD8DC" />

                        <!-- Department: [Actual Department] -->
                        <TextView
                            android:id="@+id/tvPreviewDepartment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Department: Computer Science and Engineering"
                            android:textColor="#263238"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                        <!-- Academic Year: [Actual Academic Year] -->
                        <TextView
                            android:id="@+id/tvPreviewAcademicYear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Academic Year: 2026-27"
                            android:textColor="#37474F"
                            android:textSize="12sp"
                            android:gravity="center" />

                        <!-- Semester: [Selected Semester] | Section: [Selected Section] -->
                        <TextView
                            android:id="@+id/tvPreviewSemSec"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Semester: 7th Semester | Section: Section A"
                            android:textColor="#1565C0"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                        <!-- OFFICIAL CLASS TIMETABLE -->
                        <TextView
                            android:id="@+id/tvPreviewTimetableBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:background="#E3F2FD"
                            android:text="OFFICIAL CLASS TIMETABLE"
                            android:textColor="#0D47A1"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvFitnessScore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Fitness Score: --"
                        android:textColor="#1565C0"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvConflicts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Hard Conflicts: --"
                        android:textColor="#2E7D32"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvXAIExplanation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Select the academic group and eligible subjects, then click 'Generate AI Timetable'."
                        android:textColor="#455A64"
                        android:textSize="12sp" />

                    <!-- DYNAMIC TIMETABLE SLOTS PREVIEW CONTAINER -->
                    <LinearLayout
                        android:id="@+id/llTimetableSlotsPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />

                    <Button
                        android:id="@+id/btnPublishTimetable"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="#0D47A1"
                        android:text="PUBLISH &amp; SAVE TIMETABLE TO FIRESTORE"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnExportPdf"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="#2E7D32"
                        android:text="EXPORT / PRINT OFFICIAL LANDSCAPE PDF"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Top Campus Clock Tower Artwork Illustration -->
        <ImageView
            android:id="@+id/imgWelcomeHeader"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:contentDescription="Campus Scheduler Illustration"
            android:scaleType="fitCenter"
            android:src="@drawable/img_welcome_header_artwork" />

        <!-- Header: Welcome Back 👋 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Welcome Back 👋"
            android:textColor="#1A1A1A"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Subtitle: Sign in to continue to Campus Scheduler -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Sign in to continue to Campus Scheduler"
            android:textColor="#666666"
            android:textSize="14sp" />

        <!-- College Email Field -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/icMail"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_centerVertical="true"
                android:contentDescription="Email Icon"
                android:src="@android:drawable/ic_dialog_email"
                app:tint="#5C2D91" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toEndOf="@id/icMail"
                android:background="@null"
                android:hint="College Email"
                android:inputType="textEmailAddress"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#1F1F1F"
                android:textColorHint="#9E9E9E"
                android:textSize="15sp" />

        </RelativeLayout>

        <!-- Password Field -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/icLock"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_centerVertical="true"
                android:contentDescription="Lock Icon"
                android:src="@android:drawable/ic_lock_lock"
                app:tint="#5C2D91" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toStartOf="@id/btnTogglePassword"
                android:layout_toEndOf="@id/icLock"
                android:background="@null"
                android:hint="Password"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#1F1F1F"
                android:textColorHint="#9E9E9E"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btnTogglePassword"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Toggle Password Visibility"
                android:src="@android:drawable/ic_menu_view"
                app:tint="#757575" />

        </RelativeLayout>

        <!-- Forgot Password Link -->
        <TextView
            android:id="@+id/tvForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="12dp"
            android:padding="4dp"
            android:text="Forgot Password?"
            android:textColor="#5C2D91"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- LOGIN Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_login_button"
            android:text="LOGIN"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- OR Divider Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#E0E0E0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:text="OR"
                android:textColor="#888888"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#E0E0E0" />

        </LinearLayout>

        <!-- Create New Account Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/tvRegisterLink"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_create_account_button"
            android:drawableStart="@android:drawable/ic_menu_myplaces"
            android:drawableTint="#5C2D91"
            android:paddingHorizontal="24dp"
            android:text="Create New Account"
            android:textColor="#5C2D91"
            android:textSize="15sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Terms & Privacy Policy / Secret Owner Access -->
        <TextView
            android:id="@+id/tvSecuredFirebase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="By continuing, you agree to our\nTerms of Use and Privacy Policy"
            android:textColor="#888888"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
